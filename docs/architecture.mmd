flowchart TB
    data[("<b>EINSTEIN dataset</b> · ~7M tokens<br/>1,047 researchers · 10,779 papers · 1,823 projects · 111 patents<br/>153 companies · 489 challenges · 917 company pages")]
    lib["<b>Library</b> · built at start, no model<br/>BM25 over every paper and profile · Latin and Cyrillic folded<br/>same person twice → merged · namesakes → kept apart · left / retired → flagged"]
    data --> lib

    subgraph rt ["Mozaik runtime · one event bus · every participant reacts to every event it cares about"]
        coord["<b>Coordinator</b><br/>shards the data · watches the board<br/>selects pairs when the ranking settles"]
        an["<b>Industry Analysts ×3</b><br/>each owns a third of the companies<br/>business language → research terms"]
        mm["<b>Matchmaker</b> · no model<br/>searches the library as cards land<br/>ranks pairs by fit, live"]
        pr["<b>Research Profilers ×3</b><br/>each owns whole faculties<br/>evidence cards with cited claims"]
        cr["<b>Critic</b> · runs alongside<br/>rules first (ids, authorship, years, quotes)<br/>then the model, batched"]
        wr["<b>Proposal Writer</b><br/>drafts every selected pair at once"]
        board[("<b>Shared board</b> (RuntimeState)<br/>challenge cards · pairs and ranking · evidence cards<br/>claims · proposals · critic interventions")]
    end

    lib -. search .-> mm
    lib -. sources .-> cr
    coord -- "shard.assigned" --> an
    an -- "challenge.submitted" --> cr
    cr -- "challenge.returned ↺" --> an
    cr -- "challenge.accepted" --> mm
    mm -- "pair.queued" --> pr
    pr -- "card.submitted" --> cr
    cr -- "card.returned ↺" --> pr
    cr -- "card.verified" --> mm
    mm -- "ranking.updated" --> coord
    coord -- "selection.made" --> wr
    wr -- "proposal.submitted" --> cr
    cr -- "proposal.returned ↺" --> wr
    an & mm & pr & cr & wr & coord <-.-> board

    subgraph io ["Outside the bus"]
        runner["<b>Guarded runner</b> · Mozaik InferenceRunner<br/>GEMINI_API_KEY_NTP only · free-tier pacing<br/>fallback across free models · call ledger"]
        gemini(["Gemini API · free tier"])
        out[/"<b>runs/&lt;id&gt;/</b><br/>trace.md · ranking.md · challenges.md<br/>proposals/*.md · ledger.json"/]
        cloud(["<b>Mozaik cloud</b><br/>every agent loop live"])
    end
    an & pr & cr & wr -. "runLoop" .-> runner
    runner --> gemini
    rt -- "Recorder" --> out
    rt -- "Cloud relay + loop events" --> cloud
