# The Gemini key for this entry. Spona passes it to Mozaik's Gemini endpoint explicitly
# and never reads GEMINI_API_KEY.
GEMINI_API_KEY_NTP=
# Mozaik cloud (optional): every agent loop then shows up live at https://app.jigjoy.ai
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
# Optional: strip prompts and answers from what goes to Mozaik cloud (none | content | all)
# MOZAIK_REDACTION=content
# Optional: where the dataset lives (default: data/einstein-matchmaker-data/data)
# SPONA_DATA_DIR=
